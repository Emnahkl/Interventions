<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1366</width><height>768</height></rect></property>
  <property name="windowTitle"><string>FireStation Manager - Gestion des équipements</string></property>
  <property name="styleSheet"><string notr="true">
* { font-family: "Roboto", "Segoe UI", sans-serif; font-size: 12pt; color: #2B2B2B; }
QMainWindow, QWidget#centralwidget { background: #F4F5F7; }

/* ---------- Sidebar ---------- */
QFrame#frameSidebar { background-color: #8E1B1B; background-image: url(:/images/sidebar_firefighter.jpg); background-position: center; background-repeat: no-repeat; }
QFrame#frameSidebar QLabel { color: white; background: transparent; }
QLabel#lblNomApp { font-size: 15pt; font-weight: bold; letter-spacing: 1px; }
QLabel#lblSlogan { font-size: 8pt; letter-spacing: 2px; color: rgba(255,255,255,200); }
QLabel#lblMotto { font-size: 11pt; font-weight: bold; }
QFrame#frameSidebar QPushButton { text-align: left; padding: 10px 14px; color: white; background: transparent; border: none; border-radius: 8px; }
QFrame#frameSidebar QPushButton:disabled { color: rgba(255,255,255,190); }
QFrame#frameSidebar QPushButton#btnNavEquipements { background: #E53935; font-weight: bold; }

/* ---------- Header / footer ---------- */
QFrame#frameHeader { background: white; border-bottom: 1px solid #E6E6E6; }
QLabel#lblTitreApp { background: transparent; }
QLabel#lblUtilisateur { color: #555; background: transparent; }
QFrame#frameFooter { background: #2B2B2B; }
QFrame#frameFooter QLabel { color: #DDD; font-size: 9pt; background: transparent; }

/* ---------- Cartes ---------- */
QFrame#cardListe, QFrame#cardForm { background: white; border: 1px solid #ECECEC; border-radius: 10px; }
QFrame#cardListe QLabel, QFrame#cardForm QLabel { background: transparent; border: none; }
QLabel#lblListeTitre, QLabel#lblFormTitre { font-size: 14pt; font-weight: bold; }
QLabel#lblAlertes { padding: 8px 12px; border-radius: 8px; background: #E8F5E9; color: #2E7D32; font-weight: bold; }

/* ---------- Champs ---------- */
QLineEdit, QComboBox, QSpinBox, QDateEdit { background: white; border: 1px solid #DADADA; border-radius: 6px; padding: 5px 8px; color: #2B2B2B; min-height: 22px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus { border: 1px solid #C62828; }
QLineEdit:read-only { background: #F2F2F2; color: #777; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 26px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/images/arrow_down.png); width: 12px; height: 12px; }
QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 22px; border: none; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 22px; border: none; }
QSpinBox::up-arrow { image: url(:/images/arrow_up.png); width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url(:/images/arrow_down.png); width: 10px; height: 10px; }

/* ---------- Boutons ---------- */
QPushButton#btnAjouter, QPushButton#btnNouveau { background: #C62828; color: white; border: none; border-radius: 8px; padding: 9px 16px; font-weight: bold; }
QPushButton#btnAjouter:hover, QPushButton#btnNouveau:hover { background: #B71C1C; }
QPushButton#btnModifier { background: #FF6F00; color: white; border: none; border-radius: 8px; padding: 9px 16px; font-weight: bold; }
QPushButton#btnModifier:hover { background: #E65100; }
QPushButton#btnSupprimer, QPushButton#btnVider, QPushButton#btnExportPdf, QPushButton#btnExportExcel, QPushButton#btnStats, QPushButton#btnBonCommande {
    background: white; color: #C62828; border: 1px solid #C62828; border-radius: 8px; padding: 8px 14px; font-weight: bold; }
QPushButton#btnSupprimer:hover, QPushButton#btnVider:hover, QPushButton#btnExportPdf:hover, QPushButton#btnExportExcel:hover, QPushButton#btnStats:hover, QPushButton#btnBonCommande:hover { background: #FDECEA; }

/* ---------- Tableau ---------- */
QTableView { background: white; alternate-background-color: #FAFAFA; border: 1px solid #ECECEC; border-radius: 6px; gridline-color: transparent; selection-background-color: #FDECEA; selection-color: #2B2B2B; }
QHeaderView::section { background: #F4F5F7; color: #444; padding: 8px; border: none; border-bottom: 1px solid #E0E0E0; font-weight: bold; }
</string></property>
